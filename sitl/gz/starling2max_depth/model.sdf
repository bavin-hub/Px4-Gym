<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='starling2max-Depth'>
    <include merge='true'>
      <uri>starling2max</uri>
    </include>

    <!-- Sensor-only mount: no Oak-D mesh, collision, RGB camera, or mass. -->
    <link name='depth_camera_link'>
      <pose relative_to='base_link'>.10 0 .03 0 0 0</pose>
      <inertial>
        <!-- Gazebo requires inertia on a dynamic child link.  These values are
             deliberately negligible relative to the vehicle. -->
        <mass>0.000001</mass>
        <inertia>
          <ixx>0.000000001</ixx>
          <iyy>0.000000001</iyy>
          <izz>0.000000001</izz>
        </inertia>
      </inertial>
      <sensor name='StereoOV7251' type='depth_camera'>
        <camera>
          <!-- Starling 2 Max C29 forward ToF (PMD M0178), matching CHANGE10 in
               starling2max_navigation_env.py: 240x180, HFOV 86 deg, VFOV 106
               deg, 0.2-6 m.

               The sensor has NON-SQUARE pixels (86/240 = 0.358 deg/px across,
               106/180 = 0.589 deg/px down). horizontal_fov alone cannot express
               that: gz would derive the vertical FOV from the aspect ratio and
               give 69.9 deg instead of 106. The explicit intrinsics below carry
               the real fx/fy. If a gz build ignores <lens><intrinsics> for
               depth cameras, the vertical FOV silently falls back to 69.9 deg;
               check it against the Isaac ray-caster before trusting a run. -->
          <horizontal_fov>1.5009831567</horizontal_fov>
          <lens>
            <intrinsics>
              <fx>128.684245</fx>
              <fy>67.819865</fy>
              <cx>120.0</cx>
              <cy>90.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <image>
            <width>240</width>
            <height>180</height>
            <format>R_FLOAT32</format>
          </image>
          <!-- The near plane is deliberately far below the encoder's 0.2 m
               min_range. The training ray-caster had no near plane at all, so
               sub-0.2 m returns arrived as real distances and became the Deep
               Collision Encoder's -1 "too close" sentinel. Clipping at 0.2
               instead emits -inf, which normalize_depth_image() folds onto the
               FAR plane, so an obstacle about to be hit would read as free
               space. -->
          <clip>
            <near>0.01</near>
            <far>6.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>depth_camera</topic>
      </sensor>
      <gravity>false</gravity>
    </link>
    <joint name='CameraJoint' type='fixed'>
      <parent>base_link</parent>
      <child>depth_camera_link</child>
    </joint>
  </model>
</sdf>
